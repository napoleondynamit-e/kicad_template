.env
.tools/

# Project-local links generated from .tools/kicad-happy/skills.
.agents/skills/*
!.agents/skills/hardware-architecture/
!.agents/skills/hardware-architecture/**
!.agents/skills/hardware-component-search/
!.agents/skills/hardware-component-search/**
!.agents/skills/hardware-part-validation/
!.agents/skills/hardware-part-validation/**
!.agents/skills/kicad-hardware-review/
!.agents/skills/kicad-hardware-review/**

# KiCad local state and generated output.
*.kicad_prl
*.kicad_pro-bak
*.kicad_sch-bak
*.kicad_pcb-bak
*-backups/
fp-info-cache

# Python and editor state.
__pycache__/
*.pyc
.DS_Store
.idea/
.vscode/

# Generated analysis and manufacturing files keep their directory placeholders.
work/*
!work/.gitkeep
fab/*
!fab/.gitkeep
